# Скопируйте в .env (он не попадает в git) или задайте переменные окружения перед запуском backend
DB_URL=jdbc:postgresql://localhost:5432/stomatologia
DB_USER=postgres
DB_PASSWORD=your_password
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Заполнять пустую БД демонстрационными данными
DEMO_DATA=true
# Каталог журналов Log4j2 (по умолчанию logs/ в рабочем каталоге сервера)
LOG_DIR=logs
# Адрес сайта онлайн-записи — для ссылок в ответах ИИ-менеджера
SITE_URL=http://localhost:8080
# ИИ-менеджер: ключ API Claude (console.anthropic.com). Пусто — чаты сразу передаются администратору
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Telegram-бот: токен от @BotFather. Пусто — бот выключен
TELEGRAM_BOT_TOKEN=
