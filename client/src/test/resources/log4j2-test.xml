<?xml version="1.0" encoding="UTF-8"?>
<!-- В тестах журнал пользователя (~/.stomatologia/logs) не трогаем — только предупреждения в консоль. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %c{1} : %msg%n" charset="UTF-8"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
