<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stomatologia.client.controller.LeadsController"
      styleClass="content">
    <HBox styleClass="toolbar">
        <VBox>
            <Label text="Заявки" styleClass="page-title"/>
            <Label fx:id="countLabel" styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="updatedLabel" styleClass="muted"/>
        <Button text="Новая заявка" styleClass="primary" onAction="#onAdd"/>
    </HBox>
    <HBox styleClass="toolbar">
        <ComboBox fx:id="statusFilter" prefWidth="190"/>
        <ComboBox fx:id="sourceFilter" prefWidth="170"/>
        <TextField fx:id="searchField" promptText="Поиск по имени или телефону" styleClass="search-field"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Обновить" onAction="#onRefresh"/>
    </HBox>
    <SplitPane fx:id="split" dividerPositions="0.6" VBox.vgrow="ALWAYS" styleClass="leads-split">
        <TableView fx:id="table"/>
        <ScrollPane fitToWidth="true" minWidth="340">
            <VBox fx:id="detailBox" styleClass="card,lead-detail" spacing="12"/>
        </ScrollPane>
    </SplitPane>
</VBox>
