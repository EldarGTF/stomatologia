<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stomatologia.client.controller.DashboardController"
            fitToWidth="true">
    <VBox styleClass="content">
        <HBox styleClass="toolbar">
            <VBox>
                <Label text="Dashboard" styleClass="page-title"/>
                <Label fx:id="dateLabel" styleClass="muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="updatedLabel" styleClass="muted"/>
            <Button text="Обновить" onAction="#onRefresh"/>
        </HBox>

        <HBox fx:id="alertBox" styleClass="alert-warning" spacing="12">
            <Label fx:id="alertLabel" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Открыть приёмы" onAction="#onAppointments"/>
        </HBox>

        <HBox spacing="12">
            <VBox styleClass="kpi-card,kpi-accent" HBox.hgrow="ALWAYS">
                <Label text="Приёмов сегодня" styleClass="kpi-title"/>
                <Label fx:id="appointmentsLabel" styleClass="kpi-value"/>
                <Label fx:id="appointmentsSub" styleClass="kpi-sub"/>
            </VBox>
            <VBox styleClass="kpi-card,kpi-accent" HBox.hgrow="ALWAYS">
                <Label text="Свободных окон сегодня" styleClass="kpi-title"/>
                <Label fx:id="windowsLabel" styleClass="kpi-value"/>
                <Label fx:id="windowsSub" styleClass="kpi-sub"/>
            </VBox>
            <VBox styleClass="kpi-card,kpi-accent" HBox.hgrow="ALWAYS">
                <Label text="Выручка сегодня" styleClass="kpi-title"/>
                <Label fx:id="revenueLabel" styleClass="kpi-value"/>
                <Label fx:id="revenueSub" styleClass="kpi-sub"/>
            </VBox>
            <VBox styleClass="kpi-card,kpi-accent" HBox.hgrow="ALWAYS">
                <Label text="Задолженность по счетам" styleClass="kpi-title"/>
                <Label fx:id="outstandingLabel" styleClass="kpi-value"/>
                <Label text="неоплаченные и частично оплаченные" styleClass="kpi-sub"/>
            </VBox>
        </HBox>

        <HBox spacing="12">
            <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS" prefWidth="560">
                <Label text="Выручка за 14 дней" styleClass="section-title"/>
                <BarChart fx:id="revenueChart" legendVisible="false" animated="false" prefHeight="260"
                          styleClass="revenue-chart">
                    <xAxis>
                        <CategoryAxis fx:id="dayAxis"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="amountAxis"/>
                    </yAxis>
                </BarChart>
            </VBox>
            <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="420">
                <Label text="Загрузка врачей сегодня" styleClass="section-title"/>
                <Label text="Доля рабочего времени по графику, занятая приёмами" styleClass="muted"/>
                <VBox fx:id="loadBox" spacing="12"/>
            </VBox>
        </HBox>

        <VBox styleClass="card" spacing="8">
            <HBox styleClass="toolbar">
                <Label text="Ближайшие приёмы сегодня" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Новая запись" styleClass="primary" onAction="#onBook"/>
                <Button text="Все приёмы" onAction="#onAppointments"/>
            </HBox>
            <TableView fx:id="upcomingTable" prefHeight="250"/>
        </VBox>
    </VBox>
</ScrollPane>
