<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stomatologia.client.controller.BookingController"
      styleClass="content">
    <HBox styleClass="toolbar">
        <VBox>
            <Label text="Запись на приём" styleClass="page-title"/>
            <Label fx:id="subtitleLabel" styleClass="muted"/>
        </VBox>
    </HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
            <ScrollPane fx:id="formScroll" fitToWidth="true" VBox.vgrow="ALWAYS"/>
            <HBox styleClass="toolbar">
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Очистить" onAction="#onClear"/>
                <Button fx:id="bookButton" text="Записать" styleClass="primary" onAction="#onBook"/>
            </HBox>
        </VBox>
        <VBox fx:id="upcomingCard" styleClass="card" spacing="10" prefWidth="320" minWidth="280">
            <Label text="Мои предстоящие приёмы" styleClass="section-title"/>
            <ListView fx:id="upcomingList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
</VBox>
