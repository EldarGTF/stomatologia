<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stomatologia.client.controller.ReportsController"
      styleClass="content">
    <VBox>
        <Label text="Отчёты" styleClass="page-title"/>
        <Label text="Отчёты формируются сервером по данным базы на момент запроса" styleClass="muted"/>
    </VBox>

    <VBox styleClass="card" spacing="10">
        <Label text="Период отчёта" styleClass="section-title"/>
        <HBox styleClass="toolbar">
            <Label text="с" styleClass="field-label"/>
            <DatePicker fx:id="fromPicker" prefWidth="150" minWidth="150"/>
            <Label text="по" styleClass="field-label"/>
            <DatePicker fx:id="toPicker" prefWidth="150" minWidth="150"/>
            <Region prefWidth="12"/>
            <Button text="7 дней" onAction="#onWeek" minWidth="-Infinity"/>
            <Button text="Этот месяц" onAction="#onThisMonth" minWidth="-Infinity"/>
            <Button text="Прошлый месяц" onAction="#onLastMonth" minWidth="-Infinity"/>
            <Button text="30 дней" onAction="#onThirtyDays" minWidth="-Infinity"/>
        </HBox>
        <Label fx:id="periodLabel" styleClass="muted"/>
    </VBox>

    <HBox spacing="16">
        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="400">
            <Label text="Загрузка врачей" styleClass="section-title"/>
            <Label text="Книга Excel" styleClass="badge,badge-success"/>
            <Label wrapText="true" text="По каждому врачу: рабочие дни и часы по графику, занятое приёмами время, процент загрузки, число приёмов, завершённых, неявок и отмен. Отдельный лист — загрузка по дням."/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Сформировать Excel" styleClass="primary" onAction="#onLoadReport"/>
        </VBox>
        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="400">
            <Label text="Выручка" styleClass="section-title"/>
            <Label text="Книга Excel" styleClass="badge,badge-success"/>
            <Label wrapText="true" text="Поступления по дням с разбивкой по способам оплаты, выручка по врачам и по услугам, список всех платежей. В шапке — сумма выставленных счетов и текущая задолженность."/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Сформировать Excel" styleClass="primary" onAction="#onRevenueReport"/>
        </VBox>
        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="400">
            <Label text="Талон и счёт" styleClass="section-title"/>
            <Label text="Документ Word" styleClass="badge,badge-info"/>
            <Label wrapText="true" text="Талон на приём печатается из раздела «Приёмы» (кнопка «Талон (Word)»), счёт на оплату с суммой прописью — из раздела «Оплата» (кнопка «Счёт (Word)»)."/>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox spacing="8">
                <Button text="Перейти к приёмам" onAction="#onAppointments"/>
                <Button text="Перейти к оплате" onAction="#onPayments"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
